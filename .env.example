# Supabase (TENSORRA project)
NEXT_PUBLIC_SUPABASE_URL=https://hlfjkfvlreqxvgjvyffp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CWEL6ZEDKuUN3U_WtdiUCQ_jUIVruXg

# AI provider: Groq is the default development provider
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Optional dedicated TENSORRA model endpoint.
# When set, Core v1 uses this OpenAI-compatible endpoint instead of AI_BASE_URL.
# This is the migration path to a future self-hosted TENSORRA checkpoint.
TENSORRA_MODEL_BASE_URL=
TENSORRA_MODEL_API_KEY=

# Production model routing
TENSORRA_FAST_MODEL=openai/gpt-oss-20b
TENSORRA_DEEP_MODEL=openai/gpt-oss-120b
TENSORRA_VISION_MODEL=qwen/qwen3.8-27b

# Optional staged registry overrides.
# Production overrides take precedence over the legacy variables above.
TENSORRA_PRODUCTION_FAST_MODEL=
TENSORRA_PRODUCTION_DEEP_MODEL=
TENSORRA_PRODUCTION_VISION_MODEL=

# Candidate/shadow checkpoints are NEVER promoted automatically by the app.
# They must pass Model Lab evaluation and the promotion gate first.
TENSORRA_CANDIDATE_FAST_MODEL=
TENSORRA_CANDIDATE_DEEP_MODEL=
TENSORRA_CANDIDATE_VISION_MODEL=
TENSORRA_SHADOW_FAST_MODEL=
TENSORRA_SHADOW_DEEP_MODEL=
TENSORRA_SHADOW_VISION_MODEL=
TENSORRA_SHADOW_SAMPLE_RATE=0

# Built-in model tools
TENSORRA_BROWSER_SEARCH=true
TENSORRA_CODE_INTERPRETER=true

# Optional semantic memory / RAG (Qdrant Cloud)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_MEMORY_COLLECTION=tensorra_memory
QDRANT_KNOWLEDGE_COLLECTION=tensorra_knowledge

# Optional behavior override
TENSORRA_SYSTEM_PROMPT=
